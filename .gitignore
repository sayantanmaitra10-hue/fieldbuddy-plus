# Lovable requires the root .env file to be versioned for build-time VITE_ values.
# That file must contain ONLY browser-safe public VITE_* settings.
# Never place service-role keys, database passwords, or private tokens in it.
.env.*
!.env.example

# Supabase local Edge Function secrets must remain private.
supabase/functions/.env

